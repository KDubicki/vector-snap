# --- Backend ---
VECTORSNAP_ENV=development
VECTORSNAP_LOG_LEVEL=info
# Maximum accepted upload size in megabytes
VECTORSNAP_MAX_UPLOAD_MB=10
# Maximum accepted image dimension (width or height) in pixels
VECTORSNAP_MAX_IMAGE_DIMENSION=4096
# Allowed number of colors for quantization
VECTORSNAP_MIN_COLORS=2
VECTORSNAP_MAX_COLORS=64
VECTORSNAP_MAX_SVG_SHAPES=20000
# Processing requests one worker runs at once; others wait up to the timeout, then 503
VECTORSNAP_MAX_CONCURRENT_JOBS=4
VECTORSNAP_QUEUE_TIMEOUT_S=30
# Comma-separated list of allowed CORS origins
VECTORSNAP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
# Base URL of the backend API as seen by the browser
VITE_API_BASE_URL=/api
